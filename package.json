{
  "name": "new-bakertunes",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "scripts": {
    "build": "(npm run sass:build) && (npx @11ty/eleventy --dryrun) && (npx @11ty/eleventy)",
    "watch": "npx eleventy --watch",
    "clean": "npx rimraf -v _site/",
    "serve": "(npm run clean) && (npm run sass:build) && (npx @11ty/eleventy --dryrun) && (npx @11ty/eleventy --serve & npm run sass:dev)",
    "debug": "DEBUG=* npx eleventy",
    "wdebug": "set DEBUG=Eleventy* & eleventy",
    "sass:build": "sass --style=compressed ./src/_sass/:./src/_includes/assets/css/  && npx postcss ./src/_includes/assets/css/*.css --use autoprefixer -d ./src/_includes/assets/css",
    "sass:dev": "sass --watch --update --style=expanded src/_sass/:src/_includes/assets/css/",
    "stylelint": "stylelint src/assets/**/*.scss",
    "npf": "npx postcss src/_includes/assets/css/styles.css --use autoprefixer -d src/assets/_includes/css/build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "autoprefixer": "^10.5.4",
    "clean-css": "^5.3.3",
    "dotenv": "^17.4.2",
    "eleventy-plugin-time-to-read": "^1.3.0",
    "html-minifier-terser": "^7.2.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-eleventy-img": "^0.10.2",
    "markdown-it-for-inline": "^2.0.1",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.25",
    "postcss-cli": "^11.0.1",
    "postcss-scss": "^4.0.9",
    "rimraf": "^6.1.3",
    "sass": "^1.102.0",
    "sass-autoprefixer": "^1.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.2.0",
    "uglify-js": "^3.19.3",
    "wrangler": "^4.119.0"
  }
}
