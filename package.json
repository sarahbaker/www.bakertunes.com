{
  "name": "new-bakertunes",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "scripts": {
    "build": "(npm run sass:build) && (npx @11ty/eleventy --dryrun) && (npx @11ty/eleventy)",
    "watch": "npx eleventy --watch",
    "clean": "npx rimraf -v _site/",
    "serve": "(npm run clean) && (npm run sass:build) && (npx eleventy --serve & npm run sass:dev)",
    "debug": "DEBUG=* npx eleventy",
    "wdebug": "set DEBUG=Eleventy* & eleventy",
    "sass:build": "sass --style=compressed ./_includes/assets/sass/:./_includes/assets/css/  && npx postcss ./_includes/assets/css/*.css --use autoprefixer -d ./_includes/assets/css",
    "sass:dev": "sass --watch --update --style=expanded ./_includes/assets/sass/:./_includes/assets/css/",
    "stylelint": "stylelint _includes/assets/**/*.scss",
    "npf": "npx postcss _includes/assets/css/styles.css --use autoprefixer -d _includes/assets/css/build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.4",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "autoprefixer": "^10.5.0",
    "clean-css": "^5.3.3",
    "dotenv": "^17.4.2",
    "html-minifier-terser": "^7.2.0",
    "luxon": "^3.5.0",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.2.0",
    "markdown-it-eleventy-img": "^0.10.2",
    "pagefind": "^1.5.2",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "postcss-scss": "^4.0.9",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "sass-autoprefixer": "^1.0.1",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.2",
    "stylelint-scss": "^7.0.0",
    "uglify-js": "^3.19.3",
    "wrangler": "^4.90.0"
  }
}
