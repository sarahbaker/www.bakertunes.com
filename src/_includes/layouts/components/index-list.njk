    <ul class="index-list">
    {% set cls = cycler("odd", "even") %}
    {% set sze = cycler("large","small") %}
    {%- for item in items -%}
      {% set vr = cls.next() %}
      {% if loop.index != 1 and vr == "even" %}
      {% set trash = sze.next() %}
      {% endif %}
      <li class="faux-block-link-parent index-list__item index-list__item-{{ loop.index }}{% if loop.first %} index-list__item-first{% endif %} index-list__item-{{ vr }}{% if loop.index != 1 %} index-list__item-{{ sze.next() }}{% endif %}{% if (item.data.image or item.data.youtube_id or item.data.youtube_playlist_id or item.data.soundcloud_id) %} index-list__item--with-picture{% endif %}">
        <div class="index-list__item-content">
          {% if item.data.tags | length %}
          <div class="tags">
          {%- for tag in item.data.tags %}
            {% if tag | starts_with('#', true) %}
            <small>{{ tag }}</small>
            {% endif %}
          {% endfor %}
          </div>
          {% endif %}
          <h2 data-pagefind-weight="1"><a href="{{ item.url | url }}"{% activepath item.url, page.url %}>{{ item.data.title }}</a></h2>
          {% if showDates and item.date %}
          <div class="index-list__item-date small-text"><time datetime="{{ item.date | htmlDateString }}">{{ item.date | readableDate }}</time></div>
          {% endif %}
        </div>
        {% if item.data.image %}
        {% Markdown true %}![]({{ item.data.image }}){eleventy:widths=400,600,1200 .img .index-list__item-picture .image-obj-cover}{% endMarkdown %}
        {% elif item.data.youtube_id %}
        <img src="https://img.youtube.com/vi/{{ item.data.youtube_id }}/mqdefault.jpg" alt="{{ item.data.title }}" class="img index-list__item-picture ">
        {%elif item.data.youtube_playlist.id %}
        <img src="https://img.youtube.com/vi/{{ item.data.youtube_playlist.thumbnail_id }}/mqdefault.jpg" alt="{{ item.data.title }}" class="img index-list__item-picture">
        {% elif item.data.soundcloud_id %}
        <img src="https://i1.sndcdn.com/avatars-000053069287-52pkew-t500x500.jpg" alt="{{ item.data.title }}" class="img index-list__item-picture image-obj-cover">
        {% else %}
        {% endif %}
        <a href="{{ item.url | url }}"{% activepath item.url, page.url %} class="faux-block-link"><span class="hide-text" aria-hidden="true">{{ item.data.title }}</span></a>
      </li>
    {%- endfor -%}
    </ul>

    <nav class="pagination">
      <ol>
        <li class="pagination-item first">{% if page.url != pagination.href.first %}<a href="{{ pagination.href.first }}"><span title="First">First</span></a>{% else %}<span title="First">First</span>{% endif %}</li>
        <li class="pagination-item previous">{% if pagination.href.previous %}<a href="{{ pagination.href.previous }}"><span title="Previous">Previous</span></a>{% else %}<span title="Previous">Previous</span>{% endif %}</li>
    {%- for pageEntry in pagination.pages %}
        {% if page.url == pagination.hrefs[ loop.index0 ] %}
        <li>Page {{loop.index}} of {{ pagination.hrefs | length }}</li>
        {% endif %}
        {# <li><a href="{{ pagination.hrefs[ loop.index0 ] }}"{% if page.url == pagination.hrefs[ loop.index0 ] %} class="current" aria-current="page"{% endif %}>{{ loop.index }}</a></li> #}
    {%- endfor %}
        <li class="pagination-item next">{% if pagination.href.next %}<a href="{{ pagination.href.next }}"><span title="Next">Next</span></a>{% else %}<span title="Next">Next</span>{% endif %}</li>
        <li class="pagination-item last">{% if page.url != pagination.href.last %}<a href="{{ pagination.href.last }}"><span title="Last">Last</span></a>{% else %}<span title="Last">Last</span>{% endif %}</li>
      </ol>
    </nav>