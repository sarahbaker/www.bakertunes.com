---
layout: base.njk
section: index
---
<div class="site-content content-canvas padding-block-end-md">
  {% if meta_back %}

  <p><a href="{{ meta_back.url }}" class="single-meta-item single-meta-back">{{ meta_back.title }}</a></p>

  {% endif %}

  <h1 data-pagefind-meta="title"{% if title_classes %} class="{{ title_classes | join(' ') }}"{% endif %}>{{ title }}</h1>

  {% if image %}
  <aside class="content-canvas-item-right content-canvas-item-right--span-3">
    <img src="{{ image }}" alt="{{ title }} resource" class="img-responsive img-rounded">
  </aside>
  {% endif %}

  {{ content | safe}}
</div>
{% if items | length %}

<div class="index-list-container content-canvas">
  <div class="content-canvas-item-wide">
{% include "layouts/components/index-list.njk" %}
  </div>
</div>
{% endif %}